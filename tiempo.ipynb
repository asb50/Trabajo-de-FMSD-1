    "def MinimaLongitud(lista):\n",
    "    listadelong = []\n",
    "    for i,_ in enumerate(lista):\n",
    "        if lista[i] != []:\n",
    "            listadelong.append(len(lista[i]))\n",
    "    return min(listadelong)"
