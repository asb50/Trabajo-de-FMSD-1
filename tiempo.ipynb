    "def HallarMedias(lista):\n",
    "    listamedia = []\n",
    "    lonlista = len(lista)\n",
    "    minimalon = MinimaLongitud(lista)\n",
    "    for i in range(0,minimalon):\n",
    "        t = 0\n",
    "        for est in lista:\n",
    "            if  est != [] and est[i] != None:\n",
    "                t = t + est[i]\n",
    "            elif i == 0:\n",
    "                lonlista = lonlista - 1\n",
    "        listamedia.append(t/lonlista)\n",
    "    return listamedia"
   ]
